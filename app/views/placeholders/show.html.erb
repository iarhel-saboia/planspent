<% content_for :title, "PlanSpent · #{@item[:label]}" %>

<h1 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl"><%= @item[:label] %></h1>

<section class="mt-8 flex flex-col items-center rounded-2xl bg-surface px-5 py-16 text-center shadow-sm ring-1 ring-line">
  <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400">
    <%= nav_icon(@item[:icon], "h-7 w-7") %>
  </span>
  <p class="mt-4 text-base font-semibold text-fg">Em breve</p>
  <p class="mt-1 max-w-sm text-sm text-fg-muted">Esta tela ainda será implementada.</p>
  <%= link_to "Voltar ao início", root_path, class: "mt-6 rounded-xl px-4 py-2.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-500/15" %>
</section>
