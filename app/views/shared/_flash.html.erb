<% if notice.present? || alert.present? %>
  <div data-controller="flash"
       class="fixed top-5 left-1/2 z-50 -translate-x-1/2 transition-all duration-300">
    <div class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium shadow-lg ring-1
                <%= alert.present? ? 'bg-rose-50 dark:bg-rose-500/15 text-rose-700 dark:text-rose-300 ring-rose-200 dark:ring-rose-500/30' : 'bg-surface text-fg-soft ring-line' %>">
      <span class="inline-block h-2 w-2 rounded-full <%= alert.present? ? 'bg-rose-500' : 'bg-emerald-500' %>"></span>
      <%= notice || alert %>
    </div>
  </div>
<% end %>
