<%# Shared dialog filled by the goal-link button of each entry row %>
<% if savings_goal_options.any? %>
  <%= render layout: "shared/dialog", locals: { id: "goal_link_modal", title: "Vincular a uma meta", dot: "bg-indigo-500" } do %>
    <%= form_with scope: :entry, url: "#", method: :patch, class: "mt-5 space-y-4" do |f| %>
      <p class="truncate text-sm font-medium text-fg" data-goal-link-description></p>
      <div>
        <%= f.label :goal_id, "Meta", class: "mb-1.5 block text-sm font-medium text-fg-soft" %>
        <%= f.select :goal_id, savings_goal_options, { include_blank: "Nenhuma meta" },
              class: "block w-full rounded-xl border-0 bg-surface py-2.5 px-3.5 text-fg shadow-sm ring-1 ring-line focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <p class="text-xs text-fg-muted">
        Um gasto vinculado conta como dinheiro guardado na meta (por exemplo, uma aplicação ou transferência para a poupança).
        Um crédito vinculado conta como resgate.
      </p>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" data-action="modal#close"
                class="rounded-xl px-4 py-2.5 text-sm font-semibold text-fg-soft hover:bg-surface-muted cursor-pointer">Cancelar</button>
        <%= f.submit "Salvar", class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  <% end %>
<% end %>
