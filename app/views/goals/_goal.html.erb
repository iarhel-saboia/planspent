<% colors = goal.colors %>
<article id="<%= dom_id(goal) %>" class="flex flex-col rounded-2xl bg-surface p-5 shadow-sm ring-1 ring-line">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl <%= colors[:soft] %>">
        <%= nav_icon(:flag, "h-5 w-5") %>
      </span>
      <div class="min-w-0">
        <h3 class="truncate text-base font-semibold text-fg">
          <%= link_to goal.name, goal_path(goal), class: "hover:underline" %>
        </h3>
        <p class="text-xs text-fg-muted"><%= goal_deadline(goal) %></p>
      </div>
    </div>
    <%= goal_status_badge(goal) %>
  </div>

  <div class="mt-5 flex items-baseline justify-between gap-2">
    <p class="text-2xl font-semibold tabular-nums text-fg"><%= brl(goal.saved_amount) %></p>
    <p class="text-sm tabular-nums text-fg-muted">de <%= brl(goal.target_amount) %></p>
  </div>
  <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-muted" role="progressbar"
       aria-valuenow="<%= goal.progress_percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="Progresso de <%= goal.name %>">
    <div class="h-full rounded-full <%= colors[:bar] %>" style="width: <%= goal.progress_percent %>%"></div>
  </div>
  <div class="mt-2 flex justify-between text-xs text-fg-muted">
    <span><%= goal.progress_percent %>%</span>
    <span><%= goal.completed? ? "Meta atingida" : "Faltam #{brl(goal.remaining_amount)}" %></span>
  </div>

  <% if (monthly = goal.monthly_needed) %>
    <p class="mt-4 rounded-xl bg-surface-muted px-3 py-2 text-sm text-fg-soft">
      Guarde <strong class="font-semibold text-fg"><%= brl(monthly) %>/mês</strong> para chegar no prazo.
    </p>
  <% elsif goal.status == :overdue %>
    <p class="mt-4 rounded-xl bg-surface-muted px-3 py-2 text-sm text-fg-soft">O prazo passou. Edite a meta para definir uma nova data.</p>
  <% end %>

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
    <button type="button" data-controller="modal-trigger" data-action="modal-trigger#open"
            data-modal-trigger-dialog-value="<%= contribution_modal_id(goal, false) %>"
            class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer">Guardar</button>
    <% if goal.saved_amount.positive? %>
      <button type="button" data-controller="modal-trigger" data-action="modal-trigger#open"
              data-modal-trigger-dialog-value="<%= contribution_modal_id(goal, true) %>"
              class="rounded-xl px-4 py-2 text-sm font-semibold text-fg-soft ring-1 ring-line hover:bg-surface-muted cursor-pointer">Resgatar</button>
    <% end %>
    <button type="button" data-controller="modal-trigger" data-action="modal-trigger#open"
            data-modal-trigger-dialog-value="<%= goal_modal_id(goal) %>"
            class="ml-auto rounded-xl px-3 py-2 text-sm font-medium text-fg-muted hover:bg-surface-muted hover:text-fg-soft cursor-pointer">Editar</button>
  </div>

  <%= render "goals/modals", goal: goal %>
</article>
